<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>

    <RootNamespace>TwitchToolkit</RootNamespace>
    <AssemblyName>TwitchToolkit</AssemblyName>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />

    <PackageReference Include="Lib.Harmony" Version="2.0.0.8" ExcludeAssets="runtime" />

    <PackageReference Include="MoonSharp" Version="2.0.0" />

    <PackageReference Include="HodlHodl.Rimworld.Toolkit.Core" Version="1.1.11" ExcludeAssets="runtime">
      <IncludeAssets>
        compile; build; native; contentfiles; analyzers; buildtransitive
      </IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>